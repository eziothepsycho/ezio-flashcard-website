# Environment template for the website. Copy to `.env` (git-ignored) or set these
# in your shell when you want to override the defaults.
#
# Which source of truth the app uses. Leave it unset (or set it to "local") and the
# website runs on localStorage as it always has. Only the exact value "api"
# switches accounts over to the Laravel API in backend/.
#
#   PowerShell:  $env:VITE_DATA_MODE="api"; npm run dev
#   bash:        VITE_DATA_MODE=api npm run dev
#
# VITE_DATA_MODE=api

# Where the API lives. Unset, requests go to /api, which vite.config.js proxies to
# the Laravel dev server on 127.0.0.1:8001. Set this to talk to a deployed API.
#
# VITE_API_URL=http://127.0.0.1:8001/api
