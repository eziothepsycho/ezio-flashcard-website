# Copy this file to .env — it is git-ignored, so every developer has their own
# settings and their own database. Then run:
#
#   php artisan key:generate
#   php artisan migrate
#
# Nothing secret belongs in this file: it is committed, .env is not.

APP_NAME="cards API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- database --
# MySQL / MariaDB. Create your own database once, before migrating:
#
#   CREATE DATABASE flashcard_app CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# These are the XAMPP/MAMP defaults (localhost, port 3306, user root, no
# password). Change DB_USERNAME / DB_PASSWORD if your MySQL is set up
# differently — never commit the real ones, they live in .env only.
#
# The test suite uses a second database, flashcard_app_test (set in
# phpunit.xml), so create that one too:
#
#   CREATE DATABASE flashcard_app_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flashcard_app
DB_USERNAME=root
DB_PASSWORD=

# utf8mb4_unicode_ci is what makes usernames unique case-insensitively. The
# tables inherit it from here, so leave both lines alone.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --------------------------------------------------- sessions, cache, queues --
# The API is stateless: clients send a Sanctum bearer token, the app never uses
# a cookie session, and only four tables are migrated — users, sets, cards and
# personal_access_tokens. There are no sessions/cache/jobs tables, so these
# stay on the filesystem. Registering is rate limited (3 an hour per address)
# and the counters live in the file cache, which means
# "php artisan cache:clear" resets them while you are testing.
#
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Accounts have no email address by design, so nothing is ever mailed.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
